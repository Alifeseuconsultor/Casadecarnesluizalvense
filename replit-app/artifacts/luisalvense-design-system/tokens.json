{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Sistema visual Casa Luisalvense. O tema claro foi mapeado dos tokens e estilos da tela Catálogo; o tema escuro é uma derivação da mesma paleta. Edite apenas este arquivo.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#f6f4ef" },
      "foreground": { "$value": "#1d3029" },
      "border": { "$value": "#ddd8cf" },
      "card": { "$value": "#fbfbf8" },
      "cardForeground": { "$value": "#1d3029" },
      "popover": { "$value": "#fbfbf8" },
      "popoverForeground": { "$value": "#1d3029" },
      "primary": {
        "$value": "#2a4c3f",
        "$description": "Verde profundo usado nas ações principais."
      },
      "primaryForeground": { "$value": "#f8f6ef" },
      "secondary": { "$value": "#ede2cf" },
      "secondaryForeground": { "$value": "#244236" },
      "muted": { "$value": "#ebe7e0" },
      "mutedForeground": { "$value": "#63796f" },
      "accent": {
        "$value": "#e8b254",
        "$description": "Dourado quente para ênfase, indicadores e detalhes."
      },
      "accentForeground": { "$value": "#1f382e" },
      "destructive": { "$value": "#c53c30" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#d5cec3" },
      "ring": { "$value": "#3c6d5a" },
      "chart1": { "$value": "#366352" },
      "chart2": { "$value": "#e8b254" },
      "chart3": { "$value": "#cf7d54" },
      "chart4": { "$value": "#8ca960" },
      "chart5": { "$value": "#6c859d" },
      "sidebar": { "$value": "#1f382e" },
      "sidebarForeground": { "$value": "#f4f2eb" },
      "sidebarBorder": { "$value": "#345146" },
      "sidebarPrimary": { "$value": "#e8b254" },
      "sidebarPrimaryForeground": { "$value": "#1f382e" },
      "sidebarAccent": { "$value": "#2f4c41" },
      "sidebarAccentForeground": { "$value": "#f4f2eb" },
      "sidebarRing": { "$value": "#e8b254" }
    },
    "dark": {
      "background": { "$value": "#16251d" },
      "foreground": { "$value": "#f3f0e6" },
      "border": { "$value": "#43564a" },
      "card": { "$value": "#20372e" },
      "cardForeground": { "$value": "#f3f0e6" },
      "popover": { "$value": "#263d32" },
      "popoverForeground": { "$value": "#f3f0e6" },
      "primary": { "$value": "#ddb96d" },
      "primaryForeground": { "$value": "#203a30" },
      "secondary": { "$value": "#294439" },
      "secondaryForeground": { "$value": "#f3f0e6" },
      "muted": { "$value": "#30473b" },
      "mutedForeground": { "$value": "#c4cec2" },
      "accent": { "$value": "#e3c47a" },
      "accentForeground": { "$value": "#203a30" },
      "destructive": { "$value": "#c76252" },
      "destructiveForeground": { "$value": "#ffffff" },
      "input": { "$value": "#4b5d51" },
      "ring": { "$value": "#ddb96d" },
      "chart1": { "$value": "#a9c985" },
      "chart2": { "$value": "#ddb96d" },
      "chart3": { "$value": "#df8c68" },
      "chart4": { "$value": "#8cae68" },
      "chart5": { "$value": "#93b8c2" },
      "sidebar": { "$value": "#122119" },
      "sidebarForeground": { "$value": "#f3f0e6" },
      "sidebarBorder": { "$value": "#2d4639" },
      "sidebarPrimary": { "$value": "#ddb96d" },
      "sidebarPrimaryForeground": { "$value": "#203a30" },
      "sidebarAccent": { "$value": "#213b2d" },
      "sidebarAccentForeground": { "$value": "#f3f0e6" },
      "sidebarRing": { "$value": "#ddb96d" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["ui-sans-serif", "system-ui", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "sans-serif"],
        "$description": "Pilha de sistema atual da aplicação; nenhuma fonte personalizada foi fornecida."
      },
      "serif": {
        "$value": ["ui-sans-serif", "system-ui", "sans-serif"],
        "$description": "A aplicação não carrega uma família serif própria; preservar a tipografia atual."
      },
      "mono": {
        "$value": ["ui-monospace", "SFMono-Regular", "Menlo", "Consolas", "monospace"],
        "$description": "Pilha monoespaçada do sistema para preços e rótulos técnicos."
      }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.5rem",
      "$description": "Os cartões de catálogo usam cantos próximos de 7 px; escalas menores derivam deste valor."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Passo de 4 px para compor as folgas compactas observadas no painel."
    }
  }
}
